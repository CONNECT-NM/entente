@prefix : <https://w3cid.org/entente#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@base <https://w3cid.org/entente#> .

<https://w3cid.org/entente> rdf:type owl:Ontology ;
                             owl:versionIRI <https://w3cid.org/entente/0.0.1> ;
                             owl:imports <https://w3id.org/emmo/0.0.7/elite> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  https://w3cid.org/entente#acronym
:acronym rdf:type owl:AnnotationProperty ;
         rdfs:comment "Short acronym identifying the project."@en ;
         skos:prefLabel "Acronym"@en ;
         rdfs:subPropertyOf skos:altLabel ;
         rdfs:range xsd:string ;
         rdfs:domain :Project .


###  https://w3cid.org/entente#citation_type
:citation_type rdf:type owl:AnnotationProperty ;
               rdfs:comment "The type of the cited work (e.g. journal article, conference paper, report)."@en ;
               skos:prefLabel "Citation Type"@en ;
               rdfs:range xsd:string ;
               rdfs:domain :Citation .


###  https://w3cid.org/entente#doi
:doi rdf:type owl:AnnotationProperty ;
     rdfs:comment "The Digital Object Identifier of the cited work."@en ;
     skos:prefLabel "DOI"@en ;
     rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
     rdfs:range xsd:string ;
     rdfs:domain :Citation .


###  https://w3cid.org/entente#issn_isbn
:issn_isbn rdf:type owl:AnnotationProperty ;
           rdfs:comment "The ISSN (for journals) or ISBN (for books) of the cited work."@en ;
           skos:prefLabel "ISSN / ISBN"@en ;
           rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
           rdfs:range xsd:string ;
           rdfs:domain :Citation .


###  https://w3cid.org/entente#journal_or_conference
:journal_or_conference rdf:type owl:AnnotationProperty ;
                       rdfs:comment "The name of the journal or conference in which the cited work was published."@en ;
                       skos:prefLabel "Journal or Conference"@en ;
                       rdfs:subPropertyOf <http://purl.org/dc/terms/source> ;
                       rdfs:range xsd:string ;
                       rdfs:domain :Citation .


###  https://w3cid.org/entente#name
:name rdf:type owl:AnnotationProperty ;
      rdfs:comment "A human-readable name for the resource."@en ;
      skos:prefLabel "Name"@en ;
      rdfs:subPropertyOf skos:prefLabel ;
      rdfs:range xsd:string .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://emmo.info/emmo#hasProperty
<http://emmo.info/emmo#hasProperty> rdf:type owl:ObjectProperty .


###  https://w3cid.org/entente#hasHeatTreatmentMethod
:hasHeatTreatmentMethod rdf:type owl:ObjectProperty ;
                        skos:prefLabel "Has Heat Treatment Method"@en .


###  https://w3cid.org/entente#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <https://w3id.org/emmo/emmo-for-humans#coexistsWith> ;
                 skos:prefLabel "Has Manufacturer"@en .


###  https://w3cid.org/entente#hasMicrostructure
:hasMicrostructure rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://emmo.info/emmo#hasProperty> ;
                   rdfs:range :Microstructure ;
                   skos:prefLabel "Has Microstructure"@en .


###  https://w3cid.org/entente#hasOrientation
:hasOrientation rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://emmo.info/emmo#hasProperty> ;
                rdfs:domain :Specimen ;
                skos:prefLabel "Has Orientation"@en .


###  https://w3cid.org/entente#hasSpecification
:hasSpecification rdf:type owl:ObjectProperty ;
                  skos:prefLabel "Has Specification"@en .


###  https://w3cid.org/entente#hasTargetTest
:hasTargetTest rdf:type owl:ObjectProperty ;
               rdfs:domain :Specimen ;
               rdfs:range :Specimen ;
               skos:prefLabel "Has Target Test"@en .


###  https://w3cid.org/entente#irradiated_in
:irradiated_in rdf:type owl:ObjectProperty ;
               rdfs:domain :IrradiationSet ;
               rdfs:range :IrradiationFacility ;
               rdfs:comment "Links an irradiation set to the facility in which the irradiation was performed."@en ;
               skos:prefLabel "Irradiated In"@en .


###  https://w3id.org/emmo/emmo-for-humans#coexistsWith
<https://w3id.org/emmo/emmo-for-humans#coexistsWith> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://w3cid.org/entente#IrradiationData
:IrradiationData rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty .


###  https://w3cid.org/entente#azimuthal_location
:azimuthal_location rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :IrradiationSet ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The azimuthal position of the irradiation set within the reactor."@en ;
                    skos:prefLabel "Azimuthal Location"@en .


###  https://w3cid.org/entente#began_operation_date
:began_operation_date rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain :IrradiationFacility ;
                      rdfs:range xsd:date ;
                      rdfs:comment "The date on which the irradiation facility began operation."@en ;
                      skos:prefLabel "Began Operation Date"@en .


###  https://w3cid.org/entente#ceased_operation_date
:ceased_operation_date rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain :IrradiationFacility ;
                       rdfs:range xsd:date ;
                       rdfs:comment "The date on which the irradiation facility ceased operation."@en ;
                       skos:prefLabel "Ceased Operation Date"@en .


###  https://w3cid.org/entente#cooling_rate
:cooling_rate rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :heatTreatmentData ;
              rdfs:domain :HeatTreatment ;
              rdfs:range xsd:decimal ;
              rdfs:comment "The cooling rate applied during a heat treatment step, expressed in °C/h."@en ;
              skos:prefLabel "Cooling Rate"@en .


###  https://w3cid.org/entente#country
:country rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:domain :IrradiationFacility ;
         rdfs:range xsd:string ;
         rdfs:comment "The country where the irradiation facility is located."@en ;
         skos:prefLabel "Country"@en .


###  https://w3cid.org/entente#designer
:designer rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :IrradiationFacility ;
          rdfs:range xsd:string ;
          rdfs:comment "The organisation that designed the irradiation facility."@en ;
          skos:prefLabel "Designer"@en .


###  https://w3cid.org/entente#dislocationDensity
:dislocationDensity rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :materialsData ;
                    rdfs:domain :StainlessSteel ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "The dislocation density of the material, expressed in m⁻²."@en ;
                    skos:prefLabel "Dislocation Density"@en .


###  https://w3cid.org/entente#dose
:dose rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :IrradiationSet ;
      rdfs:range xsd:decimal ;
      rdfs:comment "The total radiation dose received by the irradiation set, expressed in dpa."@en ;
      skos:prefLabel "Dose"@en .


###  https://w3cid.org/entente#dose_rate
:dose_rate rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :IrradiationSet ;
           rdfs:range xsd:decimal ;
           rdfs:comment "The radiation dose rate for the irradiation set, expressed in dpa/s."@en ;
           skos:prefLabel "Dose Rate"@en .


###  https://w3cid.org/entente#efpy
:efpy rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :IrradiationSet ;
      rdfs:range xsd:decimal ;
      rdfs:comment "The effective full power years of reactor operation corresponding to this irradiation set."@en ;
      skos:prefLabel "Effective Full Power Years (EFPY)"@en .


###  https://w3cid.org/entente#energy
:energy rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain :IrradiationSet ;
        rdfs:range xsd:decimal ;
        rdfs:comment "The energy of the irradiating particles, expressed in MeV."@en ;
        skos:prefLabel "Energy"@en .


###  https://w3cid.org/entente#entry_date
:entry_date rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :IrradiationSet ;
            rdfs:range xsd:date ;
            rdfs:comment "The date on which the specimens were placed in the irradiation facility."@en ;
            skos:prefLabel "Entry Date"@en .


###  https://w3cid.org/entente#fluence
:fluence rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:domain :IrradiationSet ;
         rdfs:range xsd:decimal ;
         rdfs:comment "The neutron fluence received by the irradiation set, expressed in n/cm²."@en ;
         skos:prefLabel "Fluence"@en .


###  https://w3cid.org/entente#flux
:flux rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :IrradiationSet ;
      rdfs:range xsd:decimal ;
      rdfs:comment "The neutron flux at the specimen location, expressed in n/(cm²·s)."@en ;
      skos:prefLabel "Flux"@en .


###  https://w3cid.org/entente#grainDescription
:grainDescription rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :materialsData ;
                  rdfs:domain :StainlessSteel ;
                  rdfs:range xsd:string ;
                  rdfs:comment "A textual description of the grain structure of the material."@en ;
                  skos:prefLabel "Grain Description"@en .


###  https://w3cid.org/entente#grainSize
:grainSize rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :materialsData ;
           rdfs:range xsd:float ;
           rdfs:comment "The size of the grains in the microstructure, expressed in μm-"@en ;
           skos:prefLabel "Grain Size"@en .


###  https://w3cid.org/entente#heatNumber
:heatNumber rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :heatTreatmentData ;
            skos:prefLabel "Heat Number"@en .


###  https://w3cid.org/entente#heatTreatmentData
:heatTreatmentData rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain :HeatTreatment ;
                   skos:prefLabel "Heat Treatment Data"@en .


###  https://w3cid.org/entente#irradiation_campaign
:irradiation_campaign rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :IrradiationData ;
                      rdfs:domain :IrradiationSet ;
                      rdfs:range xsd:string ;
                      rdfs:comment "The name or identifier of the irradiation campaign."@en ;
                      skos:prefLabel "Irradiation Campaign"@en .


###  https://w3cid.org/entente#irradiation_facility_type
:irradiation_facility_type rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :IrradiationData ;
                           rdfs:domain :IrradiationFacility ;
                           rdfs:range xsd:string ;
                           rdfs:comment "The type of the irradiation facility (e.g. operating reactor, research reactor, ion facility)."@en ;
                           skos:prefLabel "Irradiation Facility Type"@en .


###  https://w3cid.org/entente#irradiation_type
:irradiation_type rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :IrradiationData ;
                  rdfs:domain :IrradiationSet ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The type of irradiation (e.g. neutron, proton, electron, ion)."@en ;
                  skos:prefLabel "Irradiation Type"@en .


###  https://w3cid.org/entente#irradiation_type_ions
:irradiation_type_ions rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :IrradiationData ;
                       rdfs:domain :IrradiationSet ;
                       rdfs:range xsd:string ;
                       rdfs:comment "The species of ions used when irradiation_type is ion irradiation."@en ;
                       skos:prefLabel "Irradiation Type — Ion Species"@en .


###  https://w3cid.org/entente#lead_factor
:lead_factor rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :IrradiationSet ;
             rdfs:range xsd:decimal ;
             rdfs:comment "The lead factor, i.e. the ratio of flux at the specimen location to flux at the vessel wall."@en ;
             skos:prefLabel "Lead Factor"@en .


###  https://w3cid.org/entente#manufacturerID
:manufacturerID rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:comment "The wikidata ID of a manufacturer"@en ;
                skos:prefLabel "Manufacturer ID"@en .


###  https://w3cid.org/entente#massFraction
:massFraction rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              skos:prefLabel "Mass Fraction"@en .


###  https://w3cid.org/entente#materialsData
:materialsData rdf:type owl:DatatypeProperty ;
               rdfs:domain :StainlessSteel ;
               skos:prefLabel "Materials Data"@en .


###  https://w3cid.org/entente#materialsSpecification
:materialsSpecification rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf :materialsData ;
                        rdfs:domain :StainlessSteel ;
                        rdfs:range xsd:string ;
                        rdfs:comment "A name specifying the material type following a standard nomenclature. The enumeration of possible values is managed by the ENTENTE interface."@en ;
                        skos:prefLabel "Materials Specification"@en .


###  https://w3cid.org/entente#materialsSpecifications
:materialsSpecifications rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :materialsData ;
                         rdfs:range xsd:string ;
                         rdfs:comment "A name specifying the material type following a standard nomenclature. The enumeration of possible values are managed by the ENTENTE interface."@en ;
                         skos:prefLabel "Materials Specifications"@en .


###  https://w3cid.org/entente#microstructureType
:microstructureType rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :materialsData ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The microstructure type expressed as one of these values: 'ferrite', 'cementite', 'austenite', 'pearlite', 'upper bainite', 'lower bainite', 'martensite'. The enumeration of possible values is managed by the ENTENTE interface."@en ;
                    skos:prefLabel "Microstructure Type"@en .


###  https://w3cid.org/entente#productForm
:productForm rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:comment "The form of the product whose material is tested. The enumeration of possible values are managed by the ENTENTE interface."@en ;
             skos:prefLabel "Product Form"@en .


###  https://w3cid.org/entente#quench_method
:quench_method rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :heatTreatmentData ;
               rdfs:domain :HeatTreatment ;
               rdfs:range xsd:string ;
               rdfs:comment "The quenching method applied after a heat treatment step (e.g. WQ, AC, FC, BQ). The enumeration of possible values is managed by the ENTENTE interface."@en ;
               skos:prefLabel "Quench Method"@en .


###  https://w3cid.org/entente#reactor_type
:reactor_type rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :IrradiationFacility ;
              rdfs:range xsd:string ;
              rdfs:comment "The reactor type (e.g. PWR, BWR, MTR)."@en ;
              skos:prefLabel "Reactor Type"@en .


###  https://w3cid.org/entente#reference_depth
:reference_depth rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain :IrradiationSet ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The reference depth within the vessel wall at which fluence/dose values are reported."@en ;
                 skos:prefLabel "Reference Depth"@en .


###  https://w3cid.org/entente#runNumber
:runNumber rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :heatTreatmentData ;
           skos:prefLabel "Run Number"@en .


###  https://w3cid.org/entente#speciesName
:speciesName rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             skos:prefLabel "Species Name"@en .


###  https://w3cid.org/entente#vessel_manufacturer
:vessel_manufacturer rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :IrradiationFacility ;
                     rdfs:range xsd:string ;
                     rdfs:comment "The organisation that manufactured the reactor pressure vessel."@en ;
                     skos:prefLabel "Vessel Manufacturer"@en .


###  https://w3cid.org/entente#withdraw_date
:withdraw_date rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :IrradiationSet ;
               rdfs:range xsd:date ;
               rdfs:comment "The date on which the specimens were withdrawn from the irradiation facility."@en ;
               skos:prefLabel "Withdraw Date"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/dc/dcmitype/Text
dcmitype:Text rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/emmo/hume#Data> .


###  http://purl.org/dc/terms/BibliographicResource
<http://purl.org/dc/terms/BibliographicResource> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/emmo/hume#Data> .


###  https://w3cid.org/entente#AirCooling
:AirCooling rdf:type owl:Class ;
            rdfs:subClassOf :QuenchMethod ;
            rdfs:comment "A quenching method in which the material is cooled in still or forced air after a heat treatment step."@en ;
            skos:prefLabel "Air Cooling (AC)"@en .


###  https://w3cid.org/entente#Austenite
:Austenite rdf:type owl:Class ;
           rdfs:subClassOf :Microstructure ;
           rdfs:comment "A face-centred cubic (FCC) iron phase, typically stable at elevated temperatures, that can be retained or transformed during cooling."@en ;
           skos:prefLabel "Austenite"@en .


###  https://w3cid.org/entente#Austenitizing
:Austenitizing rdf:type owl:Class ;
               rdfs:subClassOf :HeatTreatment ;
               rdfs:comment "A heat treatment step in which the steel is held above the upper critical temperature (Ac3) to produce a fully austenitic microstructure before quenching."@en ;
               skos:prefLabel "Austenitizing"@en .


###  https://w3cid.org/entente#BWR
:BWR rdf:type owl:Class ;
     rdfs:subClassOf :NuclearReactor ;
     rdfs:comment "A boiling water reactor (BWR) nuclear power plant used as an irradiation facility."@en ;
     skos:prefLabel "Boiling Water Reactor (BWR)"@en .


###  https://w3cid.org/entente#BrineQuench
:BrineQuench rdf:type owl:Class ;
             rdfs:subClassOf :QuenchMethod ;
             rdfs:comment "A quenching method in which the material is rapidly cooled by immersion in a brine (salt-water) solution."@en ;
             skos:prefLabel "Brine Quench (BQ)"@en .


###  https://w3cid.org/entente#Cementite
:Cementite rdf:type owl:Class ;
           rdfs:subClassOf :Microstructure ;
           rdfs:comment "An iron carbide phase (Fe3C) that forms part of the microstructure of steels, particularly in pearlite or as a separate constituent."@en ;
           skos:prefLabel "Cementite"@en .


###  https://w3cid.org/entente#CharpyImpactSpecimen
:CharpyImpactSpecimen rdf:type owl:Class ;
                      rdfs:subClassOf :Specimen ;
                      rdfs:comment "A notched bar specimen used in a Charpy impact test to measure the energy absorbed during fracture."@en ;
                      skos:prefLabel "Charpy Impact Specimen"@en .


###  https://w3cid.org/entente#Charpy_U_Notch
:Charpy_U_Notch rdf:type owl:Class ;
                rdfs:subClassOf :CharpyImpactSpecimen ;
                rdfs:comment "A Charpy impact specimen with a U-shaped notch (ISO 148-1 type U)."@en ;
                skos:prefLabel "Charpy U-Notch"@en .


###  https://w3cid.org/entente#Charpy_V_Notch
:Charpy_V_Notch rdf:type owl:Class ;
                rdfs:subClassOf :CharpyImpactSpecimen ;
                rdfs:comment "A Charpy impact specimen with a V-shaped notch (ISO 148-1 / ASTM E23 standard geometry)."@en ;
                skos:prefLabel "Charpy V-Notch"@en .


###  https://w3cid.org/entente#Citation
:Citation rdf:type owl:Class ;
          rdfs:subClassOf dcmitype:Text ,
                          <http://purl.org/dc/terms/BibliographicResource> ;
          rdfs:comment "A bibliographic reference to a publication (journal article, conference paper, report, etc.) associated with ENTENTE data."@en ;
          skos:prefLabel "Citation"@en .


###  https://w3cid.org/entente#CompactTension_CT
:CompactTension_CT rdf:type owl:Class ;
                   rdfs:subClassOf :FractureToughness ;
                   rdfs:comment "A compact tension (CT) specimen geometry used to measure fracture toughness (KIc, JIc) according to ASTM E399 / E1820."@en ;
                   skos:prefLabel "Compact Tension (CT)"@en .


###  https://w3cid.org/entente#Duration
:Duration rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/emmo/hume#Property> ;
          rdfs:comment "The elapsed time associated with a process or treatment step."@en ;
          skos:exactMatch <https://w3id.org/emmo#EMMO_0adabf6f_7404_44cb_9f65_32d83d8101a3> ;
          skos:prefLabel "Duration"@en .


###  https://w3cid.org/entente#ElectronIrradiation
:ElectronIrradiation rdf:type owl:Class ;
                     rdfs:subClassOf :IrradiationSource ;
                     rdfs:comment "An irradiation process using accelerated electrons as the damaging particle source."@en ;
                     skos:prefLabel "Electron Irradiation"@en .


###  https://w3cid.org/entente#Ferrite
:Ferrite rdf:type owl:Class ;
         rdfs:subClassOf :Microstructure ;
         rdfs:comment "A body-centred cubic (BCC) iron phase that is the primary constituent of low-alloy ferritic steels at room temperature."@en ;
         skos:prefLabel "Ferrite"@en .


###  https://w3cid.org/entente#Forging
:Forging rdf:type owl:Class ;
         rdfs:subClassOf :ProductForm ;
         rdfs:comment "A product form produced by plastic deformation of metal under compressive force; typically a thick section with directional grain flow."@en ;
         skos:prefLabel "Forging"@en .


###  https://w3cid.org/entente#FractureToughness
:FractureToughness rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/emmo/hume#Characterisation> ;
                   rdfs:comment "A characterisation technique that quantifies the resistance of a material to crack propagation, yielding parameters such as KIc or JIc."@en ;
                   skos:prefLabel "Fracture Toughness"@en .


###  https://w3cid.org/entente#FractureToughnessSpecimen
:FractureToughnessSpecimen rdf:type owl:Class ;
                           rdfs:subClassOf :Specimen ;
                           rdfs:comment "A specimen geometry designed and machined for fracture toughness testing."@en ;
                           skos:prefLabel "Fracture Toughness Specimen"@en .


###  https://w3cid.org/entente#FurnaceCooling
:FurnaceCooling rdf:type owl:Class ;
                rdfs:subClassOf :QuenchMethod ;
                rdfs:comment "A quenching method in which the material is cooled slowly inside the furnace, approximating equilibrium cooling conditions."@en ;
                skos:prefLabel "Furnace Cooling (FC)"@en .


###  https://w3cid.org/entente#HAZ
:HAZ rdf:type owl:Class ;
     rdfs:subClassOf :ProductForm ;
     rdfs:comment "The heat-affected zone (HAZ) of a weld: the region of base metal adjacent to the weld fusion boundary that has been thermally altered without melting."@en ;
     skos:prefLabel "Heat-Affected Zone (HAZ)"@en .


