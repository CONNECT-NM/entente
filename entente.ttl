:IonIrradiation rdf:type owl:Class ;
                rdfs:subClassOf :IrradiationSource ;
                rdfs:comment "An irradiation process using accelerated heavy ions (e.g. Fe²⁺, Ni²⁺) as the damaging particle source, typically performed in an ion accelerator."@en ;
                skos:prefLabel "Ion Irradiation"@en .


