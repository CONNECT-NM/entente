:IonIrradiationFacility rdf:type owl:Class ;
                        rdfs:subClassOf :IrradiationFacility ;
                        rdfs:comment "An irradiation facility based on an ion accelerator, used to simulate neutron damage by bombarding specimens with energetic ions."@en ;
                        skos:prefLabel "Ion Irradiation Facility"@en .


