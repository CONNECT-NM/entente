@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3cid.org/entente#> .

<https://w3cid.org/entente> rdf:type owl:Ontology ;
                             owl:imports <https://w3id.org/emmo/0.0.7/elite> .

#################################################################
#    Object Properties
#################################################################

###  http://emmo.info/emmo#hasProperty
<http://emmo.info/emmo#hasProperty> rdf:type owl:ObjectProperty .


###  https://w3cid.org/entente#hasHeatTreatmentMethod
:hasHeatTreatmentMethod rdf:type owl:ObjectProperty .


###  https://w3cid.org/entente#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <https://w3id.org/emmo/emmo-for-humans#coexistsWith> .


###  https://w3cid.org/entente#hasMicrostructure
:hasMicrostructure rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://emmo.info/emmo#hasProperty> ;
                   rdfs:range :Microstructure .


###  https://w3cid.org/entente#hasOrientation
:hasOrientation rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://emmo.info/emmo#hasProperty> ;
                rdfs:domain :Specimen .


###  https://w3cid.org/entente#hasSpecification
:hasSpecification rdf:type owl:ObjectProperty .


###  https://w3cid.org/entente#hasTargetTest
:hasTargetTest rdf:type owl:ObjectProperty ;
               rdfs:domain :Specimen ;
               rdfs:range :Specimen .


###  https://w3id.org/emmo/emmo-for-humans#coexistsWith
<https://w3id.org/emmo/emmo-for-humans#coexistsWith> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://w3cid.org/entente#grainSize
:grainSize rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :materialsData ;
           rdfs:range xsd:float ;
           rdfs:comment "The size of the grains in the microstructure, expressed in μm-"@en .


###  https://w3cid.org/entente#heatNumber
:heatNumber rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :heatTreatmentData .


###  https://w3cid.org/entente#heatTreatmentData
:heatTreatmentData rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain :HeatTreatment .


###  https://w3cid.org/entente#manufacturerID
:manufacturerID rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:comment "The wikidata ID of a manufacturer"@en .


###  https://w3cid.org/entente#massFraction
:massFraction rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty .


###  https://w3cid.org/entente#materialsData
:materialsData rdf:type owl:DatatypeProperty ;
               rdfs:domain :StainlessSteel .


###  https://w3cid.org/entente#materialsSpecifications
:materialsSpecifications rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :materialsData ;
                         rdfs:range xsd:string ;
                         rdfs:comment "A name specifying the material type following a standard nomenclature. The enumeration of possible values are managed by the ENTENTE interface."@en .


###  https://w3cid.org/entente#microstructureType
:microstructureType rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :materialsData ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The microstructure type expressed as one of these values: 'ferrite', 'cementite', 'austenite', 'pearlite', 'upper bainite', 'lower bainite', 'martensite'. The enumeration of possible values is managed by the ENTENTE interface."@en .


###  https://w3cid.org/entente#productForm
:productForm rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:comment "The form of the product whose material is tested. The enumeration of possible values are managed by the ENTENTE interface."@en .


###  https://w3cid.org/entente#runNumber
:runNumber rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :heatTreatmentData .


###  https://w3cid.org/entente#speciesName
:speciesName rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty .


